{
  "schema_version": "0.2.0",
  "id": "twincometflux.agent",
  "version": "0.1.0",
  "name": "TwinCometFlux Agent",
  "description": "Custom agent to run TwinCometFlux pipeline commands (djx, webx, gfx).",
  "author": "JPG Creation",
  "contact": "support@jpgcreate.dev",
  "repository": "https://github.com/jpgcreate/twintubeflux",
  "license": "MIT",
  "entry": "agent_core/cli_wrapper.py",
  "workdir": "agent_core",
  "icon": "assets/icon.png",

  "commands": [
    {
      "id": "analyzer",
      "name": "analyzer.py",
      "path": "agent_core/analyzer.py",
      "description": "Analyze a file or directory (calls djx.analyzer.run)",
      "args": [
        { "name": "--analyze", "type": "path", "required": true, "description": "File or directory to analyze" },
        { "name": "--recursive", "type": "flag", "description": "Recurse folders" }
      ],
      "auto_approve": true,
      "timeout_seconds": 60,
      "allowed_paths": ["agent_core/**", "agent_core/djx/**"]
    }
  ],

  "auto_approve": true,
  "auto_approve_commands": ["analyzer"],
  "max_requests": 25,
  "timeout_seconds": 60,
  "allowed_paths": ["agent_core/**", "agent_core/djx/**"],

  "environment": {
    "PYTHONPATH": "."
  },

  "resources": {
    "cpu_cores": 0.5,
    "memory_mb": 256
  },

  "security": {
    "sandbox": true,
    "network_access": false,
    "filesystem_access": ["agent_core/**"]
  }
}
